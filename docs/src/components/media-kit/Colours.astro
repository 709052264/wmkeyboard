---
/** Brand swatches. Clicking one copies its hex. */
import { COLOURS } from '../../lib/media-kit.mjs';

const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ');
// Pick label ink by luminance so every swatch stays readable.
const ink = (hex: string) => {
	const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
	return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.6 ? '#191C42' : '#FFFFFF';
};
---

<div class="mk-gradient not-content" aria-hidden="true">
	<span>#4C8DF6</span><span>#8B5CF6</span>
</div>
<ul class="mk-swatches not-content">
	{
		COLOURS.map((c) => (
			<li>
				<button
					type="button"
					data-wm-copy={c.hex}
					style={`--swatch: ${c.hex}; --ink: ${ink(c.hex)}`}
					aria-label={`Copy ${c.name}, ${c.hex}`}
				>
					<span class="chip">
						<span data-wm-copy-label>{c.hex}</span>
					</span>
					<span class="meta">
						<strong>{c.name}</strong>
						<span>RGB {rgb(c.hex)}</span>
						<span>{c.use}</span>
					</span>
				</button>
			</li>
		))
	}
</ul>

<script>
	import './copy';
</script>

<style>
	.mk-gradient {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		height: 5.5rem;
		margin-block: 1rem;
		padding: 0.75rem 1rem;
		border-radius: 1rem;
		background: linear-gradient(135deg, #4c8df6, #8b5cf6);
		color: #fff;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
	}
	.mk-swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	button {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		overflow: hidden;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: start;
		cursor: copy;
	}
	button:hover {
		border-color: var(--sl-color-gray-3);
	}
	.chip {
		display: flex;
		align-items: flex-end;
		height: 4.5rem;
		padding: 0.5rem 0.7rem;
		background: var(--swatch);
		color: var(--ink);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.08);
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.6rem 0.7rem 0.7rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.meta strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}
</style>
