---
/**
 * Splash hero with the live theme deck, WM Keyboard logo, and stat chips.
 *
 * On the homepage this replaces starlight-theme-black's hero with a
 * full-screen layout: title, logo, tagline and actions on the left,
 * a fanned deck of live ThemePreview cards (ThemeDeck) on the right,
 * followed by the stat chips strip and empty background space down to 100dvh.
 */
import { Image } from 'astro:assets';
import { LinkButton } from 'starlight-theme-black/components';
import ThemeBlackHero from 'starlight-theme-black/overrides/Hero.astro';
import ThemeDeck from './ThemeDeck.astro';
import InstallDialog from './InstallDialog.astro';
import logoImg from '../assets/logo.png';
import languages from '../data/languages.json';
import wordlists from '../data/wordlists.json';

const isHome = Astro.locals.starlightRoute.id === '';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

{
	!isHome ? (
		<ThemeBlackHero />
	) : (
		<div class="wm-hero-screen">
			<div class="wm-hero">
				<div class="wm-hero-copy">
					<Image src={logoImg} alt="WM Keyboard Logo" class="wm-hero-logo-img" width={140} height={140} loading="eager" />
					{/* Starlight's skip link and "back to top" both target `_top`. */}
					<h1 id="_top" data-page-title set:html={title} />
					{tagline && <p class="wm-hero-tagline" set:html={tagline} />}
					{actions.length > 0 && (
						<div class="wm-hero-actions">
							{actions.map(
								({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
									<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
										{text}
										{icon?.html && <Fragment set:html={icon.html} />}
									</LinkButton>
								),
							)}
						</div>
					)}
				</div>
				<ThemeDeck />
			</div>
			<div class="wm-stats not-content">
				<a href="/languages/overview/"><strong data-count={languages.length}>{languages.length}</strong> languages</a>
				<a href="/languages/custom-layouts/"><strong data-count={1277}>1,277</strong> layouts</a>
				<a href="/languages/dictionaries/"><strong data-count={wordlists.length}>{wordlists.length}</strong> wordlists</a>
				<a href="/tools/overview/"><strong data-count={63}>63</strong> toolbar tools</a>
				<a href="/tools/whisper/"><strong data-count={29}>29</strong> Whisper models</a>
				<a href="/tools/ai/"><strong data-count={8}>8</strong> local LLMs</a>
			</div>
			<InstallDialog />
		</div>
	)
}

<script>
	function animateStats() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			return;
		}

		const statEls = document.querySelectorAll<HTMLElement>('.wm-stats strong[data-count]');
		if (!statEls.length) return;

		const duration = 800; // ms per chip animation
		const staggerDelay = 120; // ms delay between chip starts

		statEls.forEach((el, index) => {
			const target = parseInt(el.dataset.count || '0', 10);
			if (isNaN(target) || target <= 0) return;

			const startDelay = index * staggerDelay;
			let startTime: number | null = null;

			function step(timestamp: number) {
				if (!startTime) startTime = timestamp;
				const elapsed = timestamp - startTime;

				if (elapsed < startDelay) {
					el.textContent = '0';
					requestAnimationFrame(step);
					return;
				}

				const animElapsed = elapsed - startDelay;
				const progress = Math.min(1, animElapsed / duration);
				const easeProgress = 1 - Math.pow(1 - progress, 3);
				const current = Math.floor(easeProgress * target);

				el.textContent = current.toLocaleString();

				if (progress < 1) {
					requestAnimationFrame(step);
				} else {
					el.textContent = target.toLocaleString();
				}
			}

			el.textContent = '0';
			requestAnimationFrame(step);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', animateStats);
	} else {
		animateStats();
	}
	document.addEventListener('astro:page-load', animateStats);
</script>

<style>
	.wm-hero-screen {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: calc(100dvh - var(--sl-nav-height, 3.5rem));
		/* Optical centering: extra bottom padding shifts visual weight slightly above mathematical center */
		padding-top: 1rem;
		padding-bottom: 4.5rem;
		box-sizing: border-box;
		gap: 1.5rem;
	}
	.wm-hero {
		display: grid;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		/* Rotated deck corners may poke past the column; never cause a scrollbar. */
		overflow-x: clip;
		box-sizing: border-box;
	}
	.wm-hero-copy {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}
	.wm-hero-logo-img {
		width: 4rem;
		height: 4rem;
		border-radius: 22%;
		display: block;
		object-fit: contain;
	}
	.wm-hero-copy h1 {
		margin: 0;
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.wm-hero-tagline {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: clamp(1rem, 1.8vw, 1.1875rem);
		line-height: 1.65;
		text-wrap: balance;
		max-width: 42ch;
	}
	.wm-hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1rem;
		padding-top: 0.25rem;
	}

	.wm-hero-screen :global(.wm-stats) {
		margin-top: 0;
		margin-bottom: 0;
	}

	@media (min-width: 64rem) {
		.wm-hero-screen {
			padding-top: 1.5rem;
			padding-bottom: 5.5rem;
			gap: 2rem;
		}
		.wm-hero {
			grid-template-columns: 1fr 1.1fr;
			gap: 2rem;
			margin-inline: -2.5rem;
			padding-inline: 2.5rem;
			width: calc(100% + 5rem);
		}
		.wm-hero-copy {
			align-items: flex-start;
			text-align: left;
		}
		.wm-hero-logo-img {
			width: 4.75rem;
			height: 4.75rem;
		}
		.wm-hero-actions {
			justify-content: flex-start;
		}
	}
</style>

