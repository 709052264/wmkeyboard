# Cloudflare Pages response headers.
#
# Core Web Vitals is a ranking input, and the largest thing this site can do
# about it is stop re-downloading assets that can never change. Astro
# fingerprints everything under /_astro/, so those URLs are immutable by
# construction; the HTML is not, and must always be revalidated or a deploy
# reaches nobody who has visited before.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

/*.png
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# The two files an assistant fetches, and the sitemap a crawler re-reads.
/llms.txt
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/llms-full.txt
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Every page's Markdown copy, for an assistant to read rather than a search
# engine to index: the HTML page is the one to rank, and two copies of every
# page would compete with each other. Readable from any origin, like the
# files above, so a browser-based agent can fetch them too.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

/llms-full.txt
  Access-Control-Allow-Origin: *

# What the search API and the MCP server rank (functions/_docs.ts).
/ai/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/openapi.json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/.well-known/mcp/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Nothing here is served to be framed or sniffed, and a referrer leaking the
# full path of a settings page to an outbound link buys nobody anything.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
