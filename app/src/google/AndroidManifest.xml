<?xml version="1.0" encoding="utf-8"?>
<!--
    Additions for every build with Google's SDKs, which is every build but
    F-Droid's (app/build.gradle.kts adds this file when wmkb.enableFdroid is
    off).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WMFullApplication starts WorkManager on first use (ML Kit's ink model
         downloads), so its androidx.startup initializer is taken out of every
         process start, the keyboard's included. -->
    <application
        android:name="com.wasimaster.wmkeyboard.app.WMFullApplication"
        tools:replace="android:name">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
