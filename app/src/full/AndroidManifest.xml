<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-build-only additions.

    The Harper spell checker used to live here, when lite shipped no
    libharper_jni.so. The spell checker is declared in the main manifest now,
    in every edition, and its grammar half simply stays quiet on a build made
    without the library.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WMFullApplication starts WorkManager on first use (ML Kit's ink model
         downloads), so its androidx.startup initializer is taken out of every
         process start, the keyboard's included. -->
    <application
        android:name="com.wasimaster.wmkeyboard.app.WMFullApplication"
        tools:replace="android:name">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
