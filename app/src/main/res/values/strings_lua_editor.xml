<?xml version="1.0" encoding="utf-8"?>
<!--
  What the plugin editor says is wrong with a Lua script. One string for each
  LuaDiagnosticCode in core/plugins, named lua_diag_ and the code in lower case;
  LuaDiagnosticTextTest holds the two lists together. Lua names such as render,
  on_event, wm.storage and local are code and stay as written.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ================================================================== -->
    <!-- The text itself.                                                    -->
    <!-- ================================================================== -->

    <!-- %1$s is the characters Lua cannot read. -->
    <string name="lua_diag_unknown_character">Lua cannot read <xliff:g id="text" example="$">%1$s</xliff:g> here.</string>
    <string name="lua_diag_unclosed_string">This string has no closing quote before the end of the line.</string>
    <string name="lua_diag_unclosed_long_string">This long string has no closing brackets.</string>
    <string name="lua_diag_unclosed_comment">This comment has no closing brackets.</string>
    <!-- %1$s is an opening bracket: ( or { or [. -->
    <string name="lua_diag_unclosed_bracket">Nothing closes this <xliff:g id="bracket" example="(">%1$s</xliff:g>.</string>
    <!-- %1$s is the closing bracket that was typed, %2$s the one the open bracket needs. -->
    <string name="lua_diag_wrong_closer">This is <xliff:g id="found" example=")">%1$s</xliff:g>, but the open bracket needs <xliff:g id="wanted" example="}">%2$s</xliff:g>.</string>
    <!-- %1$s is a closing bracket. -->
    <string name="lua_diag_stray_closer">No open bracket is here for this <xliff:g id="bracket" example=")">%1$s</xliff:g> to close.</string>
    <!-- %1$s is the Lua keyword that starts the block, %2$s the keyword that must close it (end or until). -->
    <string name="lua_diag_unclosed_block">This <xliff:g id="keyword" example="if">%1$s</xliff:g> has no <xliff:g id="closer" example="end">%2$s</xliff:g>.</string>
    <!-- %1$s is the Lua text found, %2$s a list of what Lua accepts there. -->
    <string name="lua_diag_syntax_expected">Lua expected <xliff:g id="expected" example="then">%2$s</xliff:g> here, and found <xliff:g id="found" example="y">%1$s</xliff:g>.</string>
    <!-- %1$s is the Lua text found. -->
    <string name="lua_diag_syntax">Lua did not expect <xliff:g id="found" example="=">%1$s</xliff:g> here.</string>
    <!-- %1$s is a list of what Lua accepts next. -->
    <string name="lua_diag_syntax_at_end_expected">The script stops too soon. Lua expected <xliff:g id="expected" example="end">%1$s</xliff:g> next.</string>
    <string name="lua_diag_syntax_at_end">The script stops too soon.</string>

    <!-- ================================================================== -->
    <!-- What the sandbox does not give a plugin. %1$s is a Lua name.         -->
    <!-- ================================================================== -->

    <string name="lua_diag_removed_loads_code"><xliff:g id="name" example="require">%1$s</xliff:g> is not available. A plugin cannot load other code.</string>
    <string name="lua_diag_removed_files"><xliff:g id="name" example="io">%1$s</xliff:g> is not available. A plugin cannot open files.</string>
    <string name="lua_diag_removed_code_from_text"><xliff:g id="name" example="load">%1$s</xliff:g> is not available. A plugin cannot run code made from text.</string>
    <string name="lua_diag_removed_coroutines"><xliff:g id="name" example="coroutine">%1$s</xliff:g> is not available. Plugins have no coroutines.</string>
    <string name="lua_diag_removed_java_or_debugger"><xliff:g id="name" example="debug">%1$s</xliff:g> is not available. A plugin cannot reach Java or the debugger.</string>
    <string name="lua_diag_never_in_api"><xliff:g id="name" example="wm.clipboard">%1$s</xliff:g> does not exist. No plugin can read text, the clipboard, files or the network.</string>
    <string name="lua_diag_os_reduced"><xliff:g id="name" example="os.getenv">%1$s</xliff:g> is not available. Plugins get os.time, os.clock and os.date only.</string>
    <string name="lua_diag_unknown_member"><xliff:g id="name" example="math.zeta">%1$s</xliff:g> does not exist.</string>
    <!-- %2$s is the real name nearest to the one written. -->
    <string name="lua_diag_member_typo"><xliff:g id="name" example="string.fromat">%1$s</xliff:g> does not exist. Did you mean <xliff:g id="near" example="string.format">%2$s</xliff:g>?</string>
    <!-- %2$s is what Lua 5.2 has in place of the Lua 5.1 name. -->
    <string name="lua_diag_lua51_name"><xliff:g id="name" example="table.maxn">%1$s</xliff:g> is from Lua 5.1. Use <xliff:g id="replacement" example="table.unpack">%2$s</xliff:g> instead.</string>
    <string name="lua_diag_lua51_gone"><xliff:g id="name" example="setfenv">%1$s</xliff:g> is from Lua 5.1, and Lua 5.2 has nothing in its place.</string>
    <string name="lua_diag_string_dump">string.dump always fails in a plugin.</string>
    <string name="lua_diag_storage_not_declared">wm.storage is nil because the manifest does not declare the storage permission.</string>
    <string name="lua_diag_reminders_not_declared">wm.reminders is nil because the manifest does not declare the reminders permission.</string>
    <string name="lua_diag_frontier_pattern">Frontier patterns stop the plugin with an error on this keyboard.</string>

    <!-- ================================================================== -->
    <!-- The plugin contract: render, on_event and the widgets.              -->
    <!-- ================================================================== -->

    <string name="lua_diag_missing_render">The script has no render function, so the panel stays empty.</string>
    <string name="lua_diag_render_returns_nothing">render returns nothing, so the panel stays empty.</string>
    <string name="lua_diag_render_parameters">render gets no arguments, so these parameters are always nil.</string>
    <string name="lua_diag_on_event_parameters">on_event gets one argument, the event. The other parameters are always nil.</string>
    <!-- %1$s is the event type the script compares with. -->
    <string name="lua_diag_unknown_event_type">No event has the type <xliff:g id="type" example="press">%1$s</xliff:g>.</string>
    <!-- %2$s is the real event type nearest to it. -->
    <string name="lua_diag_event_type_typo">No event has the type <xliff:g id="type" example="clik">%1$s</xliff:g>. Did you mean <xliff:g id="near" example="click">%2$s</xliff:g>?</string>
    <!-- %1$s is a widget id. -->
    <string name="lua_diag_unknown_event_id">No widget in this script has the id <xliff:g id="id" example="stop">%1$s</xliff:g>.</string>
    <!-- %1$s is the field, %2$s the widget constructor. -->
    <string name="lua_diag_unknown_ui_field"><xliff:g id="constructor" example="ui.column">%2$s</xliff:g> ignores the field <xliff:g id="field" example="spacing">%1$s</xliff:g>.</string>
    <!-- %1$s is the field written, %2$s the real field nearest to it. -->
    <string name="lua_diag_ui_field_typo">This widget has no field <xliff:g id="field" example="txt">%1$s</xliff:g>. Did you mean <xliff:g id="near" example="text">%2$s</xliff:g>?</string>
    <!-- %1$s is the widget constructor. -->
    <string name="lua_diag_missing_id"><xliff:g id="constructor" example="ui.button">%1$s</xliff:g> needs an id, or on_event cannot tell which widget the event is from.</string>
    <!-- %1$s is a widget id. -->
    <string name="lua_diag_duplicate_id">Another widget already has the id <xliff:g id="id" example="go">%1$s</xliff:g>.</string>
    <!-- %1$s is the style written. -->
    <string name="lua_diag_unknown_label_style">A label has no style <xliff:g id="style" example="huge">%1$s</xliff:g>. It shows as body text.</string>
    <!-- %2$s is the real style nearest to it. -->
    <string name="lua_diag_label_style_typo">A label has no style <xliff:g id="style" example="titel">%1$s</xliff:g>. Did you mean <xliff:g id="near" example="title">%2$s</xliff:g>?</string>
    <!-- %1$s is the style written. -->
    <string name="lua_diag_plain_button_style">A button has no style <xliff:g id="style" example="secondary">%1$s</xliff:g>. It shows as a plain button.</string>
    <string name="lua_diag_too_many_tabs">The keyboard shows only the first eight pages of a tab strip.</string>

    <!-- ================================================================== -->
    <!-- Lua itself. %1$s is a Lua name.                                     -->
    <!-- ================================================================== -->

    <string name="lua_diag_undefined_global">Nothing in the script defines <xliff:g id="name" example="counter">%1$s</xliff:g>.</string>
    <!-- %2$s is the name nearest to it. -->
    <string name="lua_diag_global_typo">Nothing in the script defines <xliff:g id="name" example="cuont">%1$s</xliff:g>. Did you mean <xliff:g id="near" example="count">%2$s</xliff:g>?</string>
    <string name="lua_diag_accidental_global"><xliff:g id="name" example="total">%1$s</xliff:g> is global. Write local in front of it if only this function uses it.</string>
    <string name="lua_diag_replaces_builtin">This replaces the built-in <xliff:g id="name" example="print">%1$s</xliff:g> for the whole plugin.</string>
    <string name="lua_diag_unused_local">The script never reads <xliff:g id="name" example="result">%1$s</xliff:g>.</string>
    <string name="lua_diag_shadows_library">This local hides the <xliff:g id="name" example="string">%1$s</xliff:g> library until the end of the block.</string>
    <string name="lua_diag_loop_never_ends">Nothing ends this loop, so the plugin stops when its time runs out.</string>
</resources>
