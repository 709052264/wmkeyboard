<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings assistant (#788): ask about settings in your own words. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="settings_assistant_title">Settings assistant</string>
    <string name="settings_assistant_nav_subtitle">Ask about the keyboard in your own words; it finds the settings and suggests changes</string>
    <string name="settings_assistant_ask">Ask the settings assistant</string>
    <string name="settings_assistant_intro">Say what you want from the keyboard, such as \"I keep triggering long presses\" or \"set up a mode for typing codes\". The assistant finds the settings, explains them and shows you where they are. For a few common settings it can propose a change, which happens only when you press Apply.</string>
    <string name="settings_assistant_set_up_ai">Set up an AI provider</string>
    <string name="settings_assistant_no_provider">The assistant needs an AI provider: a cloud or self-hosted one with its key or address, or an on-device model you have downloaded.</string>
    <!-- %1$s is the error the provider gave. -->
    <string name="settings_assistant_failed">The assistant couldn\'t answer: <xliff:g id="reason" example="timeout">%1$s</xliff:g></string>
    <string name="settings_assistant_hint">Ask about a setting</string>
    <string name="settings_assistant_send">Send</string>
    <string name="settings_assistant_stop">Stop</string>
    <string name="settings_assistant_clear">Clear the conversation</string>
    <string name="settings_assistant_thinking">Looking through the settings…</string>
    <!-- A proposed change. %1$s is the current value, %2$s the proposed one, such as On and Off or 300 and 450. -->
    <string name="settings_assistant_change_values"><xliff:g id="from" example="300">%1$s</xliff:g> → <xliff:g id="to" example="450">%2$s</xliff:g></string>
    <string name="settings_assistant_apply">Apply</string>
    <string name="settings_assistant_undo">Undo</string>
    <string name="settings_assistant_dismiss">Dismiss</string>
    <string name="settings_assistant_applied">Applied</string>
    <string name="settings_assistant_undone">Undone</string>
    <string name="settings_assistant_dismissed">Dismissed</string>
    <string name="settings_assistant_stale">Not applied: the setting changed after this was proposed. Ask again.</string>
    <string name="settings_assistant_undo_refused">Not undone: the setting has been changed since.</string>
    <string name="settings_assistant_open">Open</string>
    <!-- Heading over a setting the assistant points at, and the spoken name of the path down to it. -->
    <string name="settings_assistant_where">Where it is</string>
    <!-- %1$s is the setting's value now, such as On or 300 ms. -->
    <string name="settings_assistant_current">Currently <xliff:g id="value" example="On">%1$s</xliff:g></string>
    <!-- Spoken name of the model picker. %1$s is the provider and model, such as Claude · claude-sonnet-4. -->
    <string name="settings_assistant_model_desc">Answering with <xliff:g id="model" example="Claude">%1$s</xliff:g>. Pick another</string>
    <string name="settings_assistant_add_provider">Set up another provider</string>
    <!-- Label over a change the assistant proposes. -->
    <string name="settings_assistant_proposal">Suggested change</string>
