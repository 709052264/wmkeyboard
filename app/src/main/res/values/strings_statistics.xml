<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The Statistics screen, opened from About. -->
    <string name="statistics_title">Statistics</string>
    <string name="statistics_subtitle">How much you type, day by day</string>

    <string name="statistics_toggle_title">Count typing statistics</string>
    <string name="statistics_toggle_subtitle">The keyboard counts characters, words and speed. It never saves what you type.</string>
    <string name="statistics_toggle_info">The counts stay on your device. Nothing you type is saved, and nothing leaves your device. The keyboard pauses the count while incognito pauses learning.</string>

    <!-- the all-time tiles -->

    <string name="statistics_totals_section">All time</string>
    <string name="statistics_chars_label">Characters</string>
    <string name="statistics_words_label">Words</string>
    <string name="statistics_speed_label">Average speed</string>
    <string name="statistics_active_label">Time typing</string>
    <string name="statistics_backspaces_label">Backspaces</string>
    <!-- %1$d is a typing speed. wpm is short for words per minute: a unit
         like km/h, so it stays lowercase and stays with the number. -->
    <string name="statistics_wpm_value" tools:ignore="PluralsCandidate">%1$d wpm</string>
    <!-- Placeholder on a tile before there is enough data to show a number. -->
    <string name="statistics_value_none" translatable="false">—</string>
    <!-- A duration. %1$d is a number of hours, %2$d a number of minutes. -->
    <string name="statistics_duration_hours_minutes">%1$dh %2$dm</string>
    <!-- A duration under one hour. %1$d is a number of minutes. -->
    <string name="statistics_duration_minutes">%1$dm</string>

    <!-- the charts -->

    <string name="statistics_history_section">History</string>
    <!-- Caption over the choice of how wide one bar of the chart is. -->
    <string name="statistics_period_label">One bar is</string>
    <string name="statistics_period_day_label">Days</string>
    <string name="statistics_period_week_label">Weeks</string>
    <string name="statistics_period_month_label">Months</string>
    <!-- Caption over the choice of what the chart counts. -->
    <string name="statistics_chart_metric_label">The chart shows</string>
    <string name="statistics_chart_words_label">Words</string>
    <string name="statistics_chart_chars_label">Characters</string>
    <string name="statistics_chart_speed_label">Speed</string>
    <!-- The chart counts words put in by voice typing. -->
    <string name="statistics_chart_spoken_label">Spoken</string>
    <!-- Heading of the hour-of-day chart: at which hours the user types most. -->
    <string name="statistics_hours_section">When you type</string>
    <!-- %1$s is an hour shown as a time, for example "21:00". -->
    <string name="statistics_busiest_hour_label">Busiest hour: %1$s</string>
    <!-- One row of the per-day/week/month breakdown under the chart.
         %1$s is a number of words, %2$s a number of characters. -->
    <string name="statistics_bucket_detail">%1$s words · %2$s characters</string>
    <!-- The same row on a day with voice typing. %3$s is a number of words
         put in by voice typing. -->
    <string name="statistics_bucket_detail_voice">%1$s words · %2$s characters · %3$s spoken</string>

    <!-- levels and achievements (issue #390) -->

    <string name="statistics_level_section">Your level</string>
    <string name="statistics_level_info">You earn 1 XP for every word you type or say, 1 more for every word the keyboard predicted, finished or read from a glide, and 100 for every achievement step. Each level takes 500 XP more than the one before.</string>
    <!-- %1$d is the level number. -->
    <string name="statistics_level_number">Level %1$d</string>
    <!-- Progress through the current level. %1$s is the user's XP, %2$s the XP
         the next level starts at. XP is short for experience points. -->
    <string name="statistics_level_xp">%1$s / %2$s XP</string>
    <!-- %1$s is an amount of XP still needed, %2$d the next level's number. -->
    <string name="statistics_level_next">%1$s XP to level %2$d</string>
    <!-- The names that go with the levels, from the first to the last. -->
    <string name="statistics_level_title_beginner">Beginner</string>
    <string name="statistics_level_title_novice">Novice</string>
    <string name="statistics_level_title_apprentice">Apprentice</string>
    <string name="statistics_level_title_regular">Regular</string>
    <string name="statistics_level_title_skilled">Skilled</string>
    <string name="statistics_level_title_adept">Adept</string>
    <string name="statistics_level_title_expert">Expert</string>
    <string name="statistics_level_title_master">Master</string>
    <string name="statistics_level_title_grandmaster">Grandmaster</string>
    <string name="statistics_level_title_legend">Legend</string>

    <string name="statistics_achievements_section">Achievements</string>
    <string name="statistics_achievement_words_title">Words typed</string>
    <string name="statistics_achievement_words_subtitle">Every word, however it got there</string>
    <string name="statistics_achievement_saved_title">Keystrokes saved</string>
    <string name="statistics_achievement_saved_subtitle">Taps that suggestions and glides did for you</string>
    <string name="statistics_achievement_predicted_title">Words predicted</string>
    <string name="statistics_achievement_predicted_subtitle">Picked from the suggestions before you typed a letter</string>
    <string name="statistics_achievement_completed_title">Words completed</string>
    <string name="statistics_achievement_completed_subtitle">Finished from the suggestions after a few letters</string>
    <string name="statistics_achievement_glide_title">Glide typing</string>
    <string name="statistics_achievement_glide_subtitle">Words drawn with one stroke</string>
    <string name="statistics_achievement_distance_title">Glide distance</string>
    <string name="statistics_achievement_distance_subtitle">How far your finger has travelled gliding</string>
    <string name="statistics_achievement_two_thumb_title">Two-thumb typing</string>
    <string name="statistics_achievement_two_thumb_subtitle">Words made from taps and swipes together</string>
    <string name="statistics_achievement_voice_title">Voice typing</string>
    <string name="statistics_achievement_voice_subtitle">Words you said instead of typed</string>
    <!-- Which step of an achievement the user is working on. %1$d is the step,
         %2$d how many there are. -->
    <string name="statistics_achievement_step">Step %1$d of %2$d</string>
    <!-- Every step of an achievement is done. %1$d is how many there were. -->
    <plurals name="statistics_achievement_finished">
        <item quantity="one">%1$d step done</item>
        <item quantity="other">All %1$d steps done</item>
    </plurals>
    <!-- A count against its next target, as in "43/200". -->
    <string name="statistics_achievement_count">%1$s/%2$s</string>
    <!-- A distance in metres against its next target, as in "12/20 m". -->
    <string name="statistics_achievement_metres">%1$s/%2$s m</string>

    <!-- the tap heatmap (issue #390) -->

    <string name="statistics_heatmap_section">Where you tap</string>
    <string name="statistics_heatmap_info">Every tap on the letters layer is counted in the part of the key it lands on, space and backspace included. Only the counts are kept, never which key followed which. Hotter colours mean more taps.</string>
    <!-- Caption over the choice of which layout's heatmap to show. -->
    <string name="statistics_heatmap_layout_label">Layout</string>
    <!-- %1$s is a comma-separated list of letters, the most tapped first. -->
    <string name="statistics_heatmap_top">Most tapped: %1$s</string>
    <plurals name="statistics_heatmap_taps">
        <item quantity="one">%1$s tap on this layout</item>
        <item quantity="other">%1$s taps on this layout</item>
    </plurals>

    <!-- streaks and the calendar -->

    <string name="statistics_streak_section">Streaks</string>
    <string name="statistics_streak_info">A day counts when you type or say something on it. A streak stays on until one full day passes with nothing typed or said. The calendar shows the last 26 weeks, one square for each day, Monday at the top. Darker squares are busier days.</string>
    <string name="statistics_streak_current_label">Current streak</string>
    <string name="statistics_streak_longest_label">Longest streak</string>
    <string name="statistics_streak_active_label">Days typed</string>
    <plurals name="statistics_streak_days">
        <item quantity="one">%1$s day</item>
        <item quantity="other">%1$s days</item>
    </plurals>
    <!-- Under the calendar. %1$s is a number of days. -->
    <string name="statistics_calendar_summary" tools:ignore="PluralsCandidate">Days with typing in the last 26 weeks: %1$s</string>

    <!-- where the words come from -->

    <string name="statistics_sources_section">Where your words come from</string>
    <string name="statistics_sources_info">Each word counts once, by how it went in. A glided word is one stroke. A two-thumb word is taps and swipes together. Spoken words come from voice typing, and they are not part of your typing speed.</string>
    <string name="statistics_source_typed">Typed letter by letter</string>
    <string name="statistics_source_predicted">Predicted</string>
    <string name="statistics_source_completed">Completed</string>
    <string name="statistics_source_glided">Glided</string>
    <string name="statistics_source_two_thumb">Two-thumb</string>
    <string name="statistics_source_spoken">Spoken</string>
    <!-- A count and its share of all words. %1$s is a number of words,
         %2$d a percentage. -->
    <string name="statistics_source_share" tools:ignore="PluralsCandidate">%1$s · %2$d%%</string>

    <!-- voice typing (issue #761) -->

    <string name="statistics_voice_section">Voice typing</string>
    <string name="statistics_voice_info">The keyboard counts the words that voice typing puts in, the phrases, and the time the microphone listens. Spoken words earn XP. They are not part of the characters or the typing speed. Voice typing in the keyboard\'s own search boxes is not counted.</string>
    <string name="statistics_voice_words_label">Words spoken</string>
    <string name="statistics_voice_phrases_label">Phrases</string>
    <string name="statistics_voice_time_label">Time speaking</string>
    <string name="statistics_voice_speed_label">Speaking speed</string>

    <!-- personal bests -->

    <string name="statistics_bests_section">Personal bests</string>
    <string name="statistics_best_burst_title">Fastest stretch</string>
    <string name="statistics_best_burst_subtitle">Your best speed over 15 seconds or more of typing with no pause</string>
    <string name="statistics_best_day_title">Best day</string>
    <plurals name="statistics_word_count">
        <item quantity="one">%1$s word</item>
        <item quantity="other">%1$s words</item>
    </plurals>
    <string name="statistics_word_length_title">Average word length</string>
    <string name="statistics_word_length_subtitle">Letters in each word you type, pick or glide</string>
    <plurals name="statistics_letter_count">
        <item quantity="one">%1$s letter</item>
        <item quantity="other">%1$s letters</item>
    </plurals>
    <string name="statistics_correction_title">Taken back</string>
    <string name="statistics_correction_subtitle">Backspaces for each 100 characters you type</string>

    <!-- typos -->

    <string name="statistics_typos_section">Typos</string>
    <string name="statistics_typos_info">Autocorrects are the words the keyboard replaced, by itself or from the chip you tapped. Fixed by hand are the words you went back and repaired yourself. Trust is how often a correction stood once you typed on, shown after 20 have been judged. Only counts are kept, never the words.</string>
    <string name="statistics_autocorrects_label">Autocorrects</string>
    <string name="statistics_hand_fixes_label">Fixed by hand</string>
    <string name="statistics_typo_rate_label">Typos per 100 words</string>
    <string name="statistics_trust_label">Autocorrect trust</string>
    <!-- A percentage. %1$d is the number. -->
    <string name="statistics_percent_value" tools:ignore="PluralsCandidate">%1$d%%</string>
    <string name="statistics_clean_run_title">Best clean run</string>
    <string name="statistics_clean_run_subtitle">Most words in a row with no backspace, autocorrect or fix</string>
    <string name="statistics_offers_taken_title">Fixes you accepted</string>
    <string name="statistics_offers_taken_subtitle">Near-miss corrections taken from the chip</string>
    <string name="statistics_slips_section">Your signature slips</string>
    <string name="statistics_slips_info">The slips your hand makes most and the words you fix most, read from what the keyboard learned from your own fixes. They stay in that list, not in the statistics, and go when you delete it.</string>
    <!-- How many times the user fixed one typed word the same way. -->
    <plurals name="statistics_fix_pair_times">
        <item quantity="one">Fixed by hand %1$d time</item>
        <item quantity="other">Fixed by hand %1$d times</item>
    </plurals>
    <string name="statistics_learned_corrections_action">All learned corrections</string>
    <!-- The chart counts typos: autocorrects and hand fixes together. -->
    <string name="statistics_chart_typos_label">Typos</string>
    <string name="statistics_achievement_kept_title">Saved by autocorrect</string>
    <string name="statistics_achievement_kept_subtitle">Corrections that stood once you typed on</string>
    <string name="statistics_achievement_clean_title">Clean run</string>
    <string name="statistics_achievement_clean_subtitle">Your best run of words with no typo</string>

    <!-- who you are when you type: badges read off the counts -->

    <string name="statistics_persona_section">Who you are when you type</string>
    <string name="statistics_persona_info">Badges worked out from the counts on this screen: when you type, how much you take back, how you end a sentence. They change as your habits do, and need a few thousand keystrokes before they appear.</string>
    <string name="statistics_persona_night_owl">Night owl</string>
    <string name="statistics_persona_night_owl_reason">More than a third of your typing happens between 10 pm and 4 am</string>
    <string name="statistics_persona_early_bird">Early bird</string>
    <string name="statistics_persona_early_bird_reason">Nearly a third of your typing happens between 5 and 9 in the morning</string>
    <string name="statistics_persona_lunch">Lunch typist</string>
    <string name="statistics_persona_lunch_reason">Nearly a third of your typing happens between noon and 2 pm</string>
    <string name="statistics_persona_weekend">Weekend typist</string>
    <string name="statistics_persona_weekend_reason">Saturday and Sunday hold 40% or more of your keystrokes</string>
    <string name="statistics_persona_weekday">Weekday typist</string>
    <string name="statistics_persona_weekday_reason">The weekend holds a tenth of your keystrokes or fewer</string>
    <string name="statistics_persona_careful">Careful</string>
    <string name="statistics_persona_careful_reason">Fewer than 5 backspaces for every 100 characters</string>
    <string name="statistics_persona_fearless">Fearless</string>
    <string name="statistics_persona_fearless_reason">More than 15 backspaces for every 100 characters</string>
    <string name="statistics_persona_shouter">Shouter</string>
    <string name="statistics_persona_shouter_reason">At least 5 of every 100 words are in CAPITALS</string>
    <string name="statistics_persona_exclaimer">Exclaimer</string>
    <string name="statistics_persona_exclaimer_reason">Most of your sentences end in !</string>
    <string name="statistics_persona_questioner">Questioner</string>
    <string name="statistics_persona_questioner_reason">Most of your sentences end in ?</string>
    <string name="statistics_persona_full_stop">Full stop</string>
    <string name="statistics_persona_full_stop_reason">Nine in ten of your sentences end in a plain full stop</string>
    <string name="statistics_persona_ellipsis">Trailing off</string>
    <string name="statistics_persona_ellipsis_reason">Most of your sentences end in …</string>

    <!-- punctuation -->

    <string name="statistics_punctuation_section">Punctuation</string>
    <string name="statistics_punctuation_info">Every mark typed as a key of its own, by its share of all of them. Three full stops in a row count as one ellipsis. Words shouted are the words you typed in capitals.</string>
    <string name="statistics_mark_exclamation">Exclamation mark</string>
    <string name="statistics_mark_question">Question mark</string>
    <string name="statistics_mark_full_stop">Full stop</string>
    <string name="statistics_mark_comma">Comma</string>
    <string name="statistics_mark_semicolon">Semicolon</string>
    <string name="statistics_mark_colon">Colon</string>
    <string name="statistics_mark_ellipsis">Ellipsis</string>
    <string name="statistics_mark_apostrophe">Apostrophe</string>
    <string name="statistics_mark_quote">Quotation mark</string>
    <string name="statistics_shouted_title">Words shouted</string>
    <string name="statistics_shouted_subtitle">Words you typed in CAPITALS</string>

    <!-- the record book -->

    <string name="statistics_records_section">Record book</string>
    <string name="statistics_longest_word_title">Longest word</string>
    <string name="statistics_longest_word_subtitle">Letters in the longest word you typed, picked or glided. Only the length is kept.</string>
    <string name="statistics_longest_glide_title">Longest glide</string>
    <string name="statistics_longest_glide_subtitle">Letters in the longest word drawn in one stroke</string>
    <string name="statistics_longest_session_title">Longest stretch</string>
    <!-- %1$d is a number of seconds. -->
    <string name="statistics_longest_session_subtitle" tools:ignore="PluralsCandidate">Typing with no pause longer than %1$d seconds</string>
    <!-- A duration under one hour. %1$d is minutes, %2$d seconds. -->
    <string name="statistics_duration_minutes_seconds">%1$dm %2$ds</string>
    <string name="statistics_backspace_run_title">Longest backspace run</string>
    <string name="statistics_backspace_run_subtitle">Backspaces in a row</string>
    <string name="statistics_words_deleted_title">Words deleted whole</string>
    <string name="statistics_words_deleted_subtitle">Words a delete swipe took in one go</string>
    <string name="statistics_emoji_title">Emoji sent</string>
    <!-- %1$s is a number with one decimal, for example 2.5. -->
    <string name="statistics_emoji_subtitle">%1$s for every 100 words</string>

    <!-- languages -->

    <string name="statistics_languages_section">Languages</string>
    <string name="statistics_languages_info">Each word goes to the language the keyboard was on when you finished it. Only the language and a count are kept.</string>
    <plurals name="statistics_languages_count">
        <item quantity="one">You have typed in %1$d language</item>
        <item quantity="other">You have typed in %1$d languages</item>
    </plurals>

    <!-- the counts as things to picture -->

    <string name="statistics_equivalents_section">In other words</string>
    <string name="statistics_novels_title">Novels</string>
    <!-- %1$s is the number of words in one novel, for example 80,000. -->
    <plurals name="statistics_novels_subtitle">
        <item quantity="one">Your typed and spoken words as novels of %1$s word</item>
        <item quantity="other">Your typed and spoken words as novels of %1$s words</item>
    </plurals>
    <string name="statistics_time_saved_title">Time saved</string>
    <string name="statistics_time_saved_subtitle">How long the keystrokes that suggestions and glides saved would take to type at your speed</string>
    <string name="statistics_laps_title">Running track laps</string>
    <!-- %1$d is the length of one lap in metres. m is the unit symbol. -->
    <string name="statistics_laps_subtitle" tools:ignore="PluralsCandidate">Your glide distance on a %1$d m track</string>
    <string name="statistics_presses_title">Key presses</string>
    <string name="statistics_presses_subtitle">Every letter, space, mark and backspace</string>

    <!-- the weekly punch card -->

    <string name="statistics_punch_section">Your week</string>
    <string name="statistics_punch_info">Each dot is one hour of one day of the week. A bigger dot means more keystrokes in that hour. This chart counts from the version that added it, so it can start emptier than the others.</string>
    <!-- %1$s is a day of the week, for example "Tuesday". -->
    <string name="statistics_busiest_day_label">Busiest day: %1$s</string>

    <string name="statistics_empty_body">Nothing counted yet. Type somewhere, then come back.</string>
    <string name="statistics_off_body">Statistics are off. Turn them on to start counting.</string>

    <!-- deleting -->

    <string name="statistics_delete_action">Delete all statistics</string>
    <string name="statistics_delete_confirm_title">Delete all statistics?</string>
    <string name="statistics_delete_confirm_body">This deletes every count and average. You cannot get them back.</string>
</resources>
