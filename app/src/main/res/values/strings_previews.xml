<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ==== Settings previews: the small keyboard pinned under a screen's title, and the gesture demo on Gestures ==== -->
    <!-- The chip that opens the pinned keyboard preview on a landscape phone, where it is folded away. -->
    <string name="preview_chip_label">Preview</string>
    <!-- The sample drawn in the keyboard font on the Keyboard font row. Two letters of your script are fine. -->
    <string name="preview_font_sample">Aa</string>
    <!-- Spoken by screen readers for the small keyboard drawn from the current settings. -->
    <string name="preview_keyboard_desc">Preview of your keyboard with the current settings</string>

    <!-- The question above the gesture demo's three segments. -->
    <string name="preview_gesture_label">Gesture to show</string>
    <string name="preview_gesture_glide">Glide</string>
    <string name="preview_gesture_spacebar">Spacebar</string>
    <string name="preview_gesture_backspace">Backspace</string>
    <!-- The word the glide demo swipes. Keep it to lowercase letters a–z: the demo draws the stroke over an English QWERTY board and needs a key for every letter. -->
    <string name="preview_sample_word" translatable="false">hello</string>
    <!-- The text the cursor and backspace demos edit. Two words; the backspace swipe removes the last one. -->
    <string name="preview_sample_text">hello world</string>
    <!-- Two language names the spacebar demo switches between. Any two will do. -->
    <string name="preview_language_a">English</string>
    <string name="preview_language_b">Español</string>
</resources>
