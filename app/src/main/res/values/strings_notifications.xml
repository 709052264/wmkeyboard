<?xml version="1.0" encoding="utf-8"?>
<!--
   The Notifications screen. The app posts four kinds of notification and
   nothing else; each row here is one of them, and the words say what arrives
   rather than which part of the app sends it.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="home_notifications_title">Notifications</string>
    <string name="home_notifications_subtitle">What the keyboard tells you about</string>

    <string name="notify_permission_group">Permission</string>
    <string name="notify_permission_title">Allow notifications</string>
    <string name="notify_permission_subtitle">Android is not letting the keyboard show any of these yet</string>

    <string name="notify_kinds_group">What you are told about</string>
    <string name="notify_kinds_info">The keyboard posts these four kinds and nothing else: no tips, no suggestions, no advertising. Each one is about something that finishes while you are somewhere else, which is the only reason a keyboard has to interrupt you at all.</string>

    <string name="notify_downloads_title">Downloads</string>
    <string name="notify_downloads_subtitle">Progress for dictionaries, voice models and add-ons, and a line when one finishes or fails</string>

    <string name="notify_updates_title">App updates</string>
    <string name="notify_updates_subtitle">An update downloading, one waiting to be installed, and one just installed</string>

    <string name="notify_backup_title">Backup problems</string>
    <string name="notify_backup_subtitle">Only when an automatic backup does not go through. A backup that works says nothing.</string>

    <string name="notify_controls_title">Keyboard controls</string>
    <string name="notify_controls_subtitle">A permanent entry in the shade for bringing the keyboard back</string>
    <string name="notify_controls_info">Useful with Keep on screen: once the keyboard has gone down over a window with no text field in it, there is nothing left to tap to bring it back. This puts Show, Unpin and Switch keyboard in the shade instead. It stays there until you turn it off.</string>

    <string name="notify_system_group">Android\'s own settings</string>
    <string name="notify_system_title">Notification settings</string>
    <string name="notify_system_subtitle">Sound, badges and how each kind behaves</string>

    <string name="qs_pin_keyboard_label">Keep keyboard on screen</string>
    <string name="qs_show_keyboard_label">Show keyboard</string>
    <string name="qs_floating_button_label">Floating button</string>

    <!-- What a download notification calls the thing it is fetching. Each takes
         the name the settings screen shows for it. -->
    <!-- %1$s is a language name, e.g. "বাংলা · Bangla". -->
    <string name="notify_download_wordlist"><xliff:g id="language" example="Bangla">%1$s</xliff:g> word list</string>
    <!-- %1$s is a language name. -->
    <string name="notify_download_emoji_names"><xliff:g id="language" example="Bangla">%1$s</xliff:g> emoji names</string>
    <!-- %1$s is the model's name, e.g. "Small". -->
    <string name="notify_download_voice_model"><xliff:g id="model" example="Small">%1$s</xliff:g> voice model</string>
    <!-- %1$s is the model's name, e.g. "Gemma 3 1B". -->
    <string name="notify_download_ai_model"><xliff:g id="model" example="Gemma 3 1B">%1$s</xliff:g> AI model</string>
    <string name="notify_download_emoji_font">Emoji font</string>
    <!-- %1$s is the layout's name, e.g. "Khmer Angkor". -->
    <string name="notify_download_keyman_rules"><xliff:g id="layout" example="Khmer Angkor">%1$s</xliff:g> typing rules</string>

</resources>
