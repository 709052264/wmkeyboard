<?xml version="1.0" encoding="utf-8"?>
<!--
     The floating button's screen reader (#697, #765). It may retrieve window
     content, which is the one thing it exists for, and only reads it when the
     floating button's Ask AI is pressed (ScreenContextService.read) or its
     Look up is used and a word tapped (ScreenContextService.textAt, which also
     asks the tapped text for its characters' boxes). It subscribes to window
     changes only because some platforms keep no window tree for a service that
     subscribes to nothing; the events themselves are ignored. No gestures, no
     key filtering, no touch exploration, no actions.

     Not an accessibility tool (isAccessibilityTool is false): it helps the
     user ask about the screen, not use the device with a disability, and the
     Settings screen should file it accordingly.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/screen_context_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:summary="@string/screen_context_service_summary"
    tools:ignore="UnusedAttribute" />
