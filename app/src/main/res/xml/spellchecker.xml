<?xml version="1.0" encoding="utf-8"?>
<!--
    Harper checks English only, so a single English subtype is declared.
    The dialect (American/British/Canadian/Australian) is not a subtype: it
    follows the keyboard's own grammar setting, so the underlines a user
    sees in other apps match the ones the grammar tool would show.
-->
<spell-checker xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/spell_checker_name">
    <subtype
        android:label="@string/spell_checker_subtype_english"
        android:subtypeLocale="en" />
</spell-checker>
